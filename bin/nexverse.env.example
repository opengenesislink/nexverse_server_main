# OpenGenesisLINK 0.9.3.10 Dev – nexverse.env TEMPLATE (NO REAL SECRETS)
# Ziel: /etc/nexverse/nexverse.env (chmod 600, root or service owner).
# Geheimwerte ausschliesslich ueber die HTTPS World API Admin-Oberflaeche
# /api/v1/docs -> "Schluessel & Einrichtung" erstellen.
# Bestehende funktionierende Werte NICHT mit leeren Vorlagen ueberschreiben.
# Diese Datei kann mehrere Maschinen teilen, muss aber nach Rollen und
# Servern getrennt und mit minimalen Rechten verteilt werden.

# ROBUST: zentraler World-API Token-Signaturschluessel (min. 32 Bytes).
NEXVERSE_NATIVE_TOKEN_SIGNING_KEY=

# SIMULATOR: dedizierte Machine API Keys, nicht auf Robust publizieren.
# Die Gueltigkeit und Scopes werden zentral im World API Key Store verwaltet.
NEXVERSE_ECONOMY_API_KEY=
NEXVERSE_EXPERIENCES_API_KEY=
# Firestorm Allow/Block/Forget: NUR bei kontrolliert aktiviertem
# [NexExperiencesViewer] FirestormPermissionCaps=true.
# Scope: ausschliesslich experiences:viewer:permissions.
NEXVERSE_EXPERIENCES_VIEWER_PERMISSIONS_API_KEY=

# ROBUST + SIMULATOREN: gemeinsam geheimer NexBus HMAC-Key.
# Als neuer SharedKey fuer alle Nodes gleich; keine separate API-Key-ID.
NEXVERSE_NEXBUS_SHARED_KEY=
# Simulator -> Robust; Beispiel:
# NEXVERSE_NEXBUS_PEER_URL=https://robust.internal/internal/nexbus/v1/events
NEXVERSE_NEXBUS_PEER_URL=
# Robust -> Simulator(en), kommagetrennt:
NEXVERSE_NEXBUS_PEERS=

# Bestehende Portal-/IM-Secrets bei Benutzung NICHT rotieren.
NEX_PORTAL_IM_SECRET=
NEXVERSE_IM_RELAY_SIGNING_KEY=
NEXVERSE_IM_RELAY_IMAP_PASSWORD=

# OGLVoice bleibt im Release 0.9.3.10 Dev zurueckgestellt.
# Keine Medienprovider-, LiveKit- oder Viewer-Voice-Secrets hier aktivieren.
